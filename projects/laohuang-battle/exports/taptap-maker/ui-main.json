      "name": "客栈首页",
      "primary_actions": [
        "接着打（有存档）/ 入江湖（无存档）",
        "开新局（需确认覆盖）",
        "打开设置"
      ],
      "priority": "must-have",
      "purpose": "让玩家 3 秒内确认「我在第几场、还剩多少酒、下一步点哪」，并从存档直接续战。",
      "states": [
        "default",
        "new-run",
        "confirm-overwrite",
        "loading",
        "error"
      ],
      "status": "approved"
