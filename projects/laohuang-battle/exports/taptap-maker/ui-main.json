      "id": "home",
      "layout": {
        "bottom": [
          "主按钮「接着打」朱砂实底印章，84px 高，距底 210px",
          "次按钮横排「开新局」「江湖名录」，56px 高",
          "底部导航 132px：客栈 / 名录 / 酒壶 / 设置"
        ],
        "center": [
          "上段：竖排 LOGO「老黄的战斗」+ 朱砂方印「黄」",
          "中段：老黄半身立绘（肩扛缺口雁翎刀，旧斗篷落雪），占画面 32%–62% 高度",
          "立绘下沿：进度木牌「第三场 · 雪夜破庙」+ 流派标签印章（回锋 / 借力 / 残血）"
        ],
        "floating": [
          "断网窄条（顶部 6px 墨条 + 文案），3 秒收起",
          "每日签到小印（右下，可关闭）"
        ],
        "top": [
          "顶部安全区 56px 后为资源条：银两 · 酒 · 声望，右端设置齿轮（56×56）",
          "资源条下方左侧为存档时间小字「上次 昨晚 亥时」"
        ]
      },
